
if [ -f ~/.zsh_functions ]
then
  source ~/.zsh_functions
else
  echo -e "\e[31m The file of custom functions not exist.\e[0m"
fi

if [ -f ~/.zshenv ]
then
  source ~/.zshenv
  source ~/.zsh_code
else
  echo -e "\e[31m You don't have the file zshenv.\e[0m"
fi

if [ -f ~/.zshenv.local ]
then
  source ~/.zshenv.local
fi

if [ -f ~/.zsh_alias ]
then
  source ~/.zsh_alias
else
  echo -e "\e[31m The file of custom aliases not exist.\e[0m"
fi
